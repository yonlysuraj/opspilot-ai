OPSPILOT_DB_PATH=data/opspilot.sqlite3
OPSPILOT_OLLAMA_URL=http://127.0.0.1:11434
OPSPILOT_OLLAMA_MODEL=qwen3:1.7b
OPSPILOT_EMBEDDING_MODEL=nomic-embed-text
# Set a private random token of at least 32 characters to enable decisions.
OPSPILOT_APPROVER_TOKEN=
OPSPILOT_MODEL_TIMEOUT_SECONDS=180
OPSPILOT_TOOL_TIMEOUT_SECONDS=10
OPSPILOT_MCP_START_TIMEOUT_SECONDS=60
OPSPILOT_RUN_TIMEOUT_SECONDS=600
OPSPILOT_MAX_TOOL_CALLS=12
